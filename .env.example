# Copy to .env (in the project root) and fill in. .env is never committed.

# Your Docker Hub username (images are named <user>/ipmats-api and <user>/ipmats-web)
DOCKERHUB_USER=your-dockerhub-username
# Image tag, for example week2
TAG=week2

# PUBLIC values only (the same as client/.env): they are bundled into the browser app
VITE_SUPABASE_URL=https://indtgynilfigtqaljblc.supabase.co
VITE_SUPABASE_ANON_KEY=paste-the-publishable-key-here
