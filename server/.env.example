# IPMATS API (Week 1) — copy to .env and fill in. NEVER commit .env.
PORT=4000
NODE_ENV=development

# Supabase project: IPMATS (Project Settings → API)
SUPABASE_URL=https://indtgynilfigtqaljblc.supabase.co
# Publishable (anon) key — safe to share; RLS applies
SUPABASE_ANON_KEY=sb_publishable_pZ7isUSRR0kToimYFpREow_RvTsAhSV
# Service-role / secret key — SERVER ONLY. Needed for saving (projects, contractors,
# agencies, user approval, photos). Without it the API is read-only.
SUPABASE_SERVICE_ROLE_KEY=

# Allowed browser origins (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Proxy hops in front of Express (Browser -> Vercel -> Render -> Express). Default 1.
# TRUST_PROXY=1
# Set to 1 to log req.ip and X-Forwarded-For entry count for the first 20 requests (remove afterwards).
# DEBUG_PROXY=
