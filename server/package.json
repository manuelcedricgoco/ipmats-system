{
  "name": "ipmats-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "IPMATS / InfraWatch PH API (Weeks 1–3): authentication, project records, phases, finance, 360° images, automatic flagging and audit.",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test \"src/tests/*.test.js\"",
    "flags:recheck": "node --env-file=.env src/jobs/dailyFlagCheck.js --run-now",
    "seed:images": "node --env-file=.env scripts/seed-week3-images.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "exifr": "^7.1.3",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "pdfkit": "^0.15.2",
    "sharp": "0.35.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "piexifjs": "^1.0.6",
    "supertest": "^7.0.0"
  }
}
